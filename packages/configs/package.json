    "./oxlint/vue": "./oxlint/vue.json",
    "./oxlint/react": "./oxlint/react.json",
    "./oxlint/solid": "./oxlint/solid.json",
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/vue": "./tsconfig/vue.json",
    "./tsconfig/react": "./tsconfig/react.json",
    "./tsconfig/solid": "./tsconfig/solid.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "oxlint-plugin-solidjs": "^0.1.1"
  },
  "peerDependencies": {
    "oxlint": ">=1.80.0"

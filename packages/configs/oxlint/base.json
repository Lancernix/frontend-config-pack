{
  // oxlint 共享基础预设：所有框架预设都 extends 这份，保证忽略项 / 环境 / 基础规则一致
  // 规则体系：categories 按意图分组，correctness（真实 bug）全开 error，
  // suspicious（疑似 bug）降为 warn，其余类别按需在框架预设里加
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/*.min.*",
    "pnpm-lock.yaml"
  ],
  // import / promise 是社区配置的常见选择（如 soybeanjs/oxc-config），
  // 在 correctness+suspicious 级别下零噪音，值得全量开启
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // no-undef 显式关闭：oxlint 1.86 实测未激活（未定义全局不报），且 Mantine 官方配置
    // 同样显式关闭——env 的意义在于语义声明而非此规则 [R62 借鉴 Mantine]
    "no-undef": "off",
    // 控制台输出交给团队约定，默认不拦（CI 场景可改回 error）
    "no-console": "off",
    // TS 项目里枚举合并等场景误报多，默认关
    "typescript/no-unused-expressions": "off",
    // 未使用变量策略升级 [R62 借鉴 Mantine]：ignoreRestSiblings（解构省略 rest 兄弟
    // 属性不报）+ caughtErrors 不报（catch (e) 未用是常见模式）
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    // ── 防御性规则（correctness 邻域，借鉴 Mantine 官方配置 [R62]，oxlint 1.7x+ 全部可用）──
    "array-callback-return": "error",
    "no-self-compare": "error",
    "no-sequences": "error",
    "no-eval": "error",
    "no-throw-literal": "error",
    "prefer-promise-reject-errors": "error",
    "eqeqeq": ["error", "smart"],
    "radix": "error"
  }
}

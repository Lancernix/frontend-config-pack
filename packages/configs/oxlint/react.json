{
  // React + TS 预设：react / react-perf / jsx-a11y 三个插件
  // 用法：项目根 .oxlintrc.json 里
  // { "extends": ["./node_modules/@bubu/configs/oxlint/react.json"] }
  // 注意：oxlint 的 extends 不支持 npm 包名子路径，必须写 node_modules 里的文件路径
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["./base.json"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // React 17+ JSX transform 不需要 import React
    "react/react-in-jsx-scope": "off",
    // hooks 规则（依赖数组、条件调用）是最有价值的检查
    // 注意：oxlint 里 hooks 规则挂在 react 插件下，不是 react-hooks
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "error"
  }
}
